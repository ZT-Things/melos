# Example melos configuration.
# Copy to ~/.config/melos/config.toml and edit what you need.

music_dir = "~/Music/melos"
audio_format = "opus"          # "opus" or "m4a"
concurrent_downloads = 3       # 1-5

[download]
cookies_from_browser = ""      # e.g. "firefox"
proxy = ""                     # e.g. "socks5://127.0.0.1:1080"
extra_args = []                # extra yt-dlp arguments

[mpv]
extra_args = []                # extra mpv arguments

# [keys]
# down = ["j", "down"]
# up = ["k", "up"]
# quit = ["q", "ctrl+c"]
# shutdown = ["Q"]
# delete_track = ["delete"]
# visual = ["V"]
# move_down = ["J"]
# move_up = ["K"]
# rename = ["e", "F2"]
# pane_lyrics = ["5"]
# pane_stats = ["6"]
# lyrics_paste = ["P"]   # p also works in the Lyrics pane
# lyrics_edit = ["E"]    # e also works in the Lyrics pane
# lyrics_fetch = ["F"]   # f also works in the Lyrics pane
# lyrics_offset_back = ["["]
# lyrics_offset_fwd = ["]"]
