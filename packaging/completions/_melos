#compdef melos

_arguments -s \
    '--config[Path to config.toml]:config file:_files' \
    '--trace-startup[Print startup timings after the UI exits]' \
    '(-h --help)'{-h,--help}'[Show help]' \
    '(-V --version)'{-V,--version}'[Show version]' \
    '1:command:(status stop import scan)' \
    '*:music path:_files' \
    '--copy[Copy imports into ~/Music/melos/Imported]'
